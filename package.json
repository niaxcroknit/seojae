    "@capacitor/share": "^8.0.3",
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0"
